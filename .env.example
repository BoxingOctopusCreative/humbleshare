# HumbleShare — local / compose environment template
# Copy to .env and adjust. Never commit a real .env.
#
# Config precedence: process env > CLI > TOML > Infisical > defaults.
# When Infisical Machine Identity bootstrap vars are set, the API loads
# /api recursively and the web loads /ui recursively at startup.

# --- Required ---
#DATABASE_URL=postgres://humbleshare:humbleshare@localhost:5432/humbleshare?sslmode=disable
#AUTH_JWT_SECRET=dev-jwt-secret-change-me-to-a-long-random-string
#SUPERADMIN_EMAIL=you@example.com
# Optional: create the superadmin on boot (Infisical /api/auth → superadmin_password)
# SUPERADMIN_PASSWORD=
# Dev compose Traefik host (also used for invite / OAuth callback URLs):
# PUBLIC_WEB_BASE_URL=http://humbleshare.localhost
# Host-only Vite without Traefik:
PUBLIC_WEB_BASE_URL=http://localhost:5173

# --- API ---
HTTP_ADDR=:8080
CORS_ORIGINS=http://humbleshare.localhost,http://localhost,http://localhost:5173
COOKIE_SECURE=false
SESSION_MAX_AGE_SECONDS=2592000
CLAIM_RATE_LIMIT_PER_MINUTE=10
STEAM_METADATA_CACHE_TTL_SECONDS=604800
STEAM_RATE_PER_SECOND=1

# --- Mail: local SMTP (Mailpit) OR production Mailgun ---
# Dev compose sets SMTP_HOST=mailpit automatically. UI: http://localhost:8025
# SMTP_HOST=
# SMTP_PORT=1025
# SMTP_FROM=HumbleShare <noreply@localhost>
#
# Production (Infisical /api/mailgun). Ignored when SMTP_HOST is set.
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# MAILGUN_FROM=HumbleShare <noreply@example.com>
# MAILGUN_API_BASE=https://api.mailgun.net

# --- OAuth (optional; link after account exists) ---
# Infisical: /api/auth/google|discord|steam
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# DISCORD_OAUTH_CLIENT_ID=
# DISCORD_OAUTH_CLIENT_SECRET=
# STEAM_API_KEY=

# --- Cloudflare Turnstile (optional; not enforced yet) ---
# Infisical: /api/auth/turnstile
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# --- Cloudflare R2 (optional; avatar uploads use user-assets bucket) ---
# Infisical: /api/r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=humbleshare-static
# R2_PUBLIC_BASE_URL=https://static.example.com
# R2_USER_ASSETS_BUCKET=humbleshare-user-assets
# R2_USER_ASSETS_PUBLIC_BASE_URL=https://userassets.example.com

# --- Web (SvelteKit BFF) ---
API_INTERNAL_URL=http://127.0.0.1:8080

# --- Sentry (optional) ---
# API Infisical: /api/sentry → dsn, environment, release, traces_sample_rate
# Web Infisical: /ui/sentry → dsn (PUBLIC_SENTRY_DSN), server_dsn (SENTRY_DSN), environment, …
# SENTRY_DSN=
# PUBLIC_SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=1.0
# Web source-map upload (build only):
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=boxingoctopuscreative
# SENTRY_PROJECT=humbleshare-ui

# --- Infisical Machine Identity (Universal Auth; optional local, typical in production) ---
# INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=
# INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=
# INFISICAL_PROJECT_ID=
# INFISICAL_ENVIRONMENT=dev
# INFISICAL_SITE_URL=https://app.infisical.com
# INFISICAL_SECRET_PATH=/api

# --- Compose port overrides (optional) ---
# POSTGRES_PORT=5432
# TRAEFIK_HTTP_PORT=80
# TRAEFIK_DASHBOARD_PORT=8081
# MAILPIT_UI_PORT=8025
# MAILPIT_SMTP_PORT=1025
