# HumbleShare web (SvelteKit BFF) — example env
# Copy to .env.local for Vite (`npm run dev` loads it from web/).
#
# Precedence: process env > Infisical (/ui) > defaults.
# Secret path defaults to /ui when INFISICAL_SECRET_PATH is unset.
# Leave API_INTERNAL_URL / COOKIE_SECURE unset so Infisical can fill them.

# --- Infisical Machine Identity (Universal Auth) ---
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=dev
# INFISICAL_SITE_URL=https://app.infisical.com
# INFISICAL_SECRET_PATH=/ui

# --- Overrides (optional; win over Infisical when set) ---
# API_INTERNAL_URL=http://127.0.0.1:8080
# COOKIE_SECURE=false

# --- Sentry (optional; Infisical /ui/sentry) ---
# Empty PUBLIC_SENTRY_DSN= in .env.local so the client can receive Infisical's dsn at runtime.
# PUBLIC_SENTRY_DSN=
# SENTRY_DSN=https://...@o....ingest.de.sentry.io/...
# SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=1.0
# Build-time source maps (CI / local release builds):
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=boxingoctopuscreative
# SENTRY_PROJECT=humbleshare-ui
